+++ b/mods/herdr-crew-rpg/claude-statusline.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Claude Code statusLine for the Crew quota panel: saves one account's rate limits.
+
+Usage (in that account's settings.json):
+  "statusLine": {"type": "command", "command": "python3 -I <this file> <account> 2>/dev/null || true"}
+
+The account is the one whose configDir (config.json "claudeAccounts") is this process's
+CLAUDE_CONFIG_DIR (unset: ~/.claude); <account> is only the fallback. It names the cache file
+~/.cache/agent-crew/claude-<account>.json, read by quota.py and World of Codecraft. Readings from
+all sessions of an account are merged so an idle session never brings back older numbers.
+Keeps only the 5-hour and weekly used percentage and reset time; no tokens, no prompts, no
+session content. Prints nothing, so the status line stays empty.
+
+It also labels its own terminal claude.account=<account> (hc label, at most every 10 minutes), so
+mods can tell which account a Claude terminal uses (World of Codecraft: the hero's 5-hour mana).
+"""
+import fcntl
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+from datetime import datetime
+
+CACHE_DIR = os.path.expanduser("~/.cache/agent-crew")
+
+
+def epoch(value):
+    """resets_at as epoch seconds: a number (seconds or milliseconds) or an ISO date."""
+    if isinstance(value, (int, float)) and value > 0:
+        return value / 1000 if value > 1e11 else value
+    if isinstance(value, str):
+        try:
+            return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
+        except ValueError:
+            return None
+    return None
+
+
+def window(raw):
+    if not isinstance(raw, dict):
+        return None
+    pct = raw.get("used_percentage", raw.get("utilization"))
+    if not isinstance(pct, (int, float)) or not 0 <= pct <= 100:
+        return None
+    return {"used_percentage": pct, "resets_at": epoch(raw.get("resets_at"))}
+
+
+LABEL_EVERY = 600
+
+
+def label_terminal(account):
+    """hc label <this terminal> claude.account=<account>; a marker per core and terminal limits it to every 10 min."""
+    tid = os.environ.get("HC_TERMINAL_ID", "")
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", tid):
+        return  # not inside a herdr-core terminal
+    core = os.path.basename(os.environ.get("HC_TERMINAL_SOCKET", "")) or "default"
+    mark = os.path.join(CACHE_DIR, "labels", re.sub(r"[^A-Za-z0-9._-]", "_", f"{core}-{tid}"))
+    try:
+        with open(mark, encoding="utf-8") as f:
+            if f.read() == account and time.time() - os.path.getmtime(mark) < LABEL_EVERY:
+                return
+    except OSError:
+        pass
+    hc = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")
+    done = subprocess.run([hc, "label", tid, f"claude.account={account}"], capture_output=True, timeout=5, stdin=subprocess.DEVNULL)
+    if done.returncode == 0:
+        os.makedirs(os.path.dirname(mark), exist_ok=True)
+        with open(mark, "w", encoding="utf-8") as f:
+            f.write(account)
+
+
+ACCOUNT_RE = r"[a-z0-9][a-z0-9-]{0,31}"
+CONFIG = os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.json")
+
+
+def resolve_account(arg):
+    """The account of the Claude Code process running this, by its CLAUDE_CONFIG_DIR.
+
+    The argument comes from whichever settings.json defined the status line, and a session
+    started in ~ also loads ~/.claude/settings.json as its project settings, so the
+    argument alone can name another account. config.json "claudeAccounts" maps each
+    account to its configDir; the argument is used only when no configDir matches.
+    """
+    here = os.path.realpath(os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude"))
+    try:
+        with open(CONFIG, encoding="utf-8") as f:
+            accounts = json.load(f).get("claudeAccounts") or []
+    except (OSError, ValueError, AttributeError):
+        accounts = []
+    for acc in accounts:
+        if not isinstance(acc, dict) or not isinstance(acc.get("configDir"), str):
+            continue
+        if os.path.realpath(os.path.expanduser(acc["configDir"])) == here and re.fullmatch(ACCOUNT_RE, str(acc.get("account"))):
+            return acc["account"]
+    return arg if re.fullmatch(ACCOUNT_RE, arg) else None
+
+
+def merge_window(old, new):
+    """Keep the freshest reading of a window.
+
+    Several sessions share an account, and an idle one keeps re-sending the limits of
+    its last reply. Within one window (same reset time) usage only grows, so the higher
+    value is the newer one; a later reset time means a newer window. A missing new
+    reading keeps the old one.
+    """
+    if not new:
+        return old
+    if not old:
+        return new
+    old_reset, new_reset = old.get("resets_at"), new.get("resets_at")
+    if old_reset and new_reset and abs(new_reset - old_reset) > 60:
+        return new if new_reset > old_reset else old
+    return new if new["used_percentage"] >= old.get("used_percentage", -1) else old
+
+
+def main():
+    account = resolve_account(sys.argv[1] if len(sys.argv) > 1 else "")
+    if not account:
+        return
+    try:
+        label_terminal(account)
+    except (OSError, subprocess.SubprocessError):
+        pass
+    try:
+        data = json.load(sys.stdin)
+    except ValueError:
+        return
+    limits = data.get("rate_limits") if isinstance(data, dict) else None
+    limits = limits if isinstance(limits, dict) else {}
+    path = os.path.join(CACHE_DIR, f"claude-{account}.json")
+    os.makedirs(CACHE_DIR, exist_ok=True)
+    # One writer at a time per account: read, merge and replace under a lock.
+    with open(path + ".lock", "a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        try:
+            with open(path, encoding="utf-8") as f:
+                old = json.load(f)
+            old = old if isinstance(old, dict) else {}
+        except (OSError, ValueError):
+            old = {}
+        out = {"at": time.time()}
+        for slot in ("five_hour", "seven_day"):
+            out[slot] = merge_window(old.get(slot), window(limits.get(slot)))
+        if not out["five_hour"] and not out["seven_day"]:
+            out["missing"] = True  # no limits seen yet (e.g. before the first reply)
+        if {k: v for k, v in out.items() if k != "at"} == {k: v for k, v in old.items() if k != "at"} and not limits:
+            return  # nothing new: keep the time of the last real reading
+        tmp = f"{path}.{os.getpid()}.tmp"
+        with open(tmp, "w", encoding="utf-8") as f:
+            json.dump(out, f)
+        os.replace(tmp, path)
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception:  # a status line must never disturb the session
+        pass
