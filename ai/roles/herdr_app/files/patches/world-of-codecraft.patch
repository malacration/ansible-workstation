diff --git a/mods/world-of-codecraft/mana.js b/mods/world-of-codecraft/mana.js
new file mode 100644
index 0000000..4aaad93
--- /dev/null
+++ b/mods/world-of-codecraft/mana.js
@@ -0,0 +1,86 @@
+// Mana: what is left of a hero's 5-hour quota. Claude: per Claude Code account; Codex: its one login.
+// The account comes from the terminal's label claude.account (set by the Crew mod's
+// claude-statusline.py, which runs inside each Claude Code session); the numbers from that account's
+// ~/.cache/agent-crew/claude-<account>.json, on the machine the terminal runs on. Codex: the Crew mod's
+// quota.py --only codex (codex app-server, cached 2 min), run here while a Codex terminal is live; this
+// computer's Codex login stands for every Codex hero. Only the 5-hour window.
+// The shown village polls every 30 s and publishes { address: { left, acc, stale } } in the store key
+// wocc.mana, so the village, the command panel and the other village all read the same numbers.
+
+import { appHome, exec, home, readTextFile, terminals, shared, setShared } from "herdr";
+
+const KEY = "wocc.mana";
+const POLL = 30_000;
+const STALE = 15 * 60e3; // the status line refreshes every minute while a session is open
+const ACCOUNT = /^[a-z0-9][a-z0-9-]{0,31}$/;
+
+async function readAccount(acc, on) {
+  const rel = `.cache/agent-crew/claude-${acc}.json`;
+  try {
+    const text = on ? await readTextFile(rel, { on }) : await readTextFile(`${home()}/${rel}`);
+    const q = JSON.parse(text ?? "null");
+    const w = q?.five_hour;
+    if (typeof w?.used_percentage !== "number") return null;
+    const rolled = typeof w.resets_at === "number" && w.resets_at * 1000 < Date.now(); // the window reset: full again
+    return { left: rolled ? 100 : Math.max(0, Math.min(100, Math.round(100 - w.used_percentage))), acc, stale: Date.now() - (q.at ?? 0) * 1000 > STALE };
+  } catch {
+    return null;
+  }
+}
+
+const isCodex = (t) => [t.app, t.program?.key, t.status?.app].includes("codex");
+
+async function readCodex() {
+  try {
+    const r = await exec("python3", ["-I", `${appHome()}/mods/herdr-crew-rpg/quota.py`, "--only", "codex"], { timeout: 60_000 });
+    if (r.code !== 0) return null;
+    const p = JSON.parse(r.stdout).providers?.find((x) => x.id === "codex");
+    const w = p?.windows?.find((x) => x.key === "5h");
+    if (typeof w?.pct !== "number") return null; // quota.py already set pct 0 when the window has reset
+    return { left: Math.max(0, Math.min(100, 100 - w.pct)), acc: "codex", stale: Boolean(p.stale) };
+  } catch {
+    return null;
+  }
+}
+
+export class Mana {
+  constructor() {
+    this.timer = null;
+    this.busy = false;
+  }
+
+  /** Polls while `on` (the village is shown and not a demo). */
+  watch(cx, on) {
+    if (on && !this.timer) { this.timer = cx.timer.every(POLL, (cx) => this.poll(cx)); this.poll(cx); }
+    else if (!on && this.timer) { this.timer.cancel(); this.timer = null; }
+  }
+
+  poll(cx) {
+    if (this.busy) return;
+    this.busy = true;
+    cx.spawn(async () => {
+      try {
+        const out = {};
+        const seen = new Map(); // one read per machine and account
+        const live = terminals().filter((t) => t.state === "live");
+        const codex = live.some(isCodex) ? await readCodex() : null;
+        for (const t of live) {
+          if (isCodex(t)) { if (codex) out[t.address] = codex; continue; }
+          const acc = t.labels?.["claude.account"];
+          if (typeof acc !== "string" || !ACCOUNT.test(acc)) continue;
+          const slash = t.address.indexOf("/");
+          const on = slash > 0 ? t.address.slice(0, slash) : null;
+          const k = `${on ?? ""}|${acc}`;
+          if (!seen.has(k)) seen.set(k, await readAccount(acc, on));
+          if (seen.get(k)) out[t.address] = seen.get(k);
+        }
+        if (JSON.stringify(out) !== JSON.stringify(shared(KEY) ?? {})) setShared(KEY, out);
+      } finally {
+        this.busy = false;
+      }
+    });
+  }
+}
+
+/** { left (0..100), acc, stale } for a terminal address, or null. */
+export const manaOf = (address) => shared(KEY)?.[address] ?? null;
