+// spaces-titles: a space nobody named ("~", a folder) shows what the AI in it is doing: the
+// conversation title Claude Code or Codex puts in its terminal's title. Same reading as
+// agents-titles: no status glyph, no Codex run-state prefix, no thread id, no path.
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+function agentTitle(p) {
+  const raw = p?.title ?? "";
+  if (/^[~/]/.test(raw.replace(/^[^\p{L}\p{N}~/]+/u, ""))) return "";
+  let live = raw.replace(/^[^\p{L}\p{N}\p{Ps}\p{Pi}]+/u, "").replace(/^\[ [!.] \] /, "").trim();
+  if (p?.program?.key === "codex") live = live.replace(/^(Ready|Working|Thinking|Waiting|Starting|Interrupted|Done) \| /, "");
+  if (UUID.test(live) || live.includes("@") || live === p?.program?.name || live.toLowerCase() === p?.program?.key) return "";
+  return live;
+}
+// Per space nobody named, or that CAO named after its session (its terminals' cao.session label):
+// the agent title from CAO's supervisor, else the shown tab, else any tab. A name the person gave stays.
+function spaceTitles(sp, ps) {
+  const labels = new Map(terminals().map((x) => [x.address, x.labels ?? {}]));
+  const out = {};
+  for (const s of sp) {
+    const tabIds = new Set((s.tabs ?? []).map((tab) => tab.id));
+    const agents = ps.filter((p) => tabIds.has(p.tab) && p.terminal && p.program?.agent);
+    const byCao = s.named && agents.some((p) => labels.get(p.terminal)?.["cao.session"] === s.name);
+    if (s.named && !byCao) continue;
+    const active = new Set((s.tabs ?? []).filter((tab) => tab.active).map((tab) => tab.id));
+    const rank = (p) => (/supervisor/.test(labels.get(p.terminal)?.["cao.window"] ?? "") ? 2 : 0) + (active.has(p.tab) ? 1 : 0);
+    const found = [...agents].sort((a, b) => rank(b) - rank(a)).map(agentTitle).find(Boolean);
+    if (found) out[s.id] = found;
+  }
+  return out;
+}
