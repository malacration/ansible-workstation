---
# Copy to ai/rtk.yml after review; this file is not applied by the RTK worker.
- name: Prepare shared AI stack prerequisites for RTK
  ansible.builtin.import_playbook: common.yml
  tags: [rtk, ai_common]

- name: Install RTK OSS local shell filtering
  hosts: localhost
  connection: local
  become: false
  gather_facts: true
  roles:
    - role: rtk
      tags: [rtk]
