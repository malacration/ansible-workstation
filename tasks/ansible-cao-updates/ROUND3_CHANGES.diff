+"""Resolve actual RTK entrypoint variables without running any Ansible tasks."""
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+ANSIBLE_PYTHON = os.environ.get('ANSIBLE_TEST_PYTHON', '/usr/bin/python3')
+
+
+def resolve_variables(entrypoint, scope):
+    # Import only in the Ansible interpreter, which may differ from the test
+    # suite interpreter. Playbook loading/get_vars/templating execute no tasks.
+    from ansible.plugins.loader import init_plugin_loader
+    init_plugin_loader()
+    from ansible.inventory.manager import InventoryManager
+    from ansible.parsing.dataloader import DataLoader
+    from ansible.playbook import Playbook
+    from ansible.template import Templar
+    from ansible.vars.manager import VariableManager
+
+    loader = DataLoader()
+    inventory = InventoryManager(loader=loader, sources=['localhost,'])
+    manager = VariableManager(loader=loader, inventory=inventory)
+    host = inventory.get_host('localhost')
+    manager.set_host_facts('localhost', {
+        'user_id': 'fixture-user', 'env': {},
+        'getent_passwd': {'fixture-user': ['x', '1000', '1000', 'Fixture',
+                                         '/tmp/rtk-default-home', '/bin/sh']},
+    })
+    overrides = {}
+    if scope != 'defaults':
+        prefix = '/tmp/rtk-' + scope
+        overrides = {
+            'ai_stack_user': scope + '-user', 'ai_stack_home': prefix,
+            'ai_stack_bin_dir': prefix + '/custom-bin',
+            'ai_stack_cache_dir': prefix + '/custom-cache',
+            'ai_stack_environment': {'HOME': prefix, 'PATH': prefix + '/custom-bin:/usr/bin'},
+            'ai_stack_upgrade': True,
+        }
+        for key, value in overrides.items():
+            host.set_variable(key, value)
+        if scope == 'extra':
+            # Competing inventory values verify that -e retains its precedence.
+            host.set_variable('ai_stack_home', '/tmp/rtk-inventory-lower-priority')
+            manager._extra_vars = overrides
+    book = Playbook.load(str(ROOT / 'ai' / entrypoint), loader=loader, variable_manager=manager)
+    matches = [play for play in book.get_plays()
+               if any(role.get_name() == 'rtk' for role in play.get_roles())]
+    if len(matches) != 1:
+        raise AssertionError('Expected exactly one RTK play')
+    play = matches[0]
+    variables = manager.get_vars(play=play, host=host)
+    templar = Templar(loader=loader, variables=variables)
+    names = ['ai_stack_user', 'ai_stack_home', 'ai_stack_bin_dir', 'ai_stack_cache_dir',
+             'ai_stack_environment', 'ai_stack_upgrade', 'rtk_install_dir',
+             'rtk_binary', 'rtk_upgrade']
+    result = {name: templar.template(variables[name]) for name in names}
+    shared = [role for role in play.get_roles() if role.get_name() == 'ai_stack']
+    result['shared_tasks_disabled'] = (len(shared) == 1
+                                       and any(condition is False for condition in shared[0].when))
+    return result
+
+
+class RtkEntrypointTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        try:
+            probe = subprocess.run([ANSIBLE_PYTHON, '-c', 'import ansible'],
+                                   capture_output=True, text=True)
+        except OSError as error:
+            raise unittest.SkipTest('Ansible interpreter unavailable') from error
+        if probe.returncode:
+            raise unittest.SkipTest('Set ANSIBLE_TEST_PYTHON to an interpreter with Ansible')
+
+    def check_scope(self, scope):
+        for entrypoint in ['rtk.yml', 'all.yml']:
+            with self.subTest(entrypoint=entrypoint, scope=scope):
+                result = subprocess.run([
+                    ANSIBLE_PYTHON, str(Path(__file__).resolve()), '--resolve', entrypoint, scope,
+                ], capture_output=True, text=True, env=dict(os.environ, PYTHONDONTWRITEBYTECODE='1'))
+                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+                values = json.loads(result.stdout)
+                home = '/tmp/rtk-default-home' if scope == 'defaults' else '/tmp/rtk-' + scope
+                user = 'fixture-user' if scope == 'defaults' else scope + '-user'
+                binary_dir = home + ('/.local/bin' if scope == 'defaults' else '/custom-bin')
+                cache = home + ('/.cache/ai-stack' if scope == 'defaults' else '/custom-cache')
+                self.assertEqual(values['ai_stack_user'], user)
+                self.assertEqual(values['ai_stack_home'], home)
+                self.assertEqual(values['ai_stack_bin_dir'], binary_dir)
+                self.assertEqual(values['ai_stack_cache_dir'], cache)
+                self.assertEqual(values['ai_stack_environment']['HOME'], home)
+                self.assertTrue(values['ai_stack_environment']['PATH'].startswith(binary_dir + ':'))
+                self.assertEqual(values['rtk_install_dir'], home + '/.local/share/ai-stack/rtk')
+                self.assertEqual(values['rtk_binary'], binary_dir + '/rtk')
+                self.assertEqual(values['ai_stack_upgrade'], scope != 'defaults')
+                self.assertEqual(values['rtk_upgrade'], scope != 'defaults')
+                self.assertTrue(values['shared_tasks_disabled'])
+
+    def test_actual_entrypoints_resolve_shared_defaults(self):
+        self.check_scope('defaults')
+
+    def test_actual_entrypoints_preserve_inventory_overrides(self):
+        self.check_scope('inventory')
+
+    def test_actual_entrypoints_preserve_extra_variable_overrides(self):
+        self.check_scope('extra')
+
+
+if __name__ == '__main__':
+    if len(sys.argv) > 1 and sys.argv[1] == '--resolve':
+        print(json.dumps(resolve_variables(sys.argv[2], sys.argv[3])))
+    else:
+        unittest.main()
